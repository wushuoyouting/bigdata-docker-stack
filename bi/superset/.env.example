# Superset 环境变量案例
# 复制本文件为同目录 .env。
# 替换所有 CHANGE_ME 后再启动服务。
# 连接串含特殊字符，已加单引号。
SUPERSET_TAG=CHANGE_ME_SUPERSET_TAG
SUPERSET_SECRET_KEY=CHANGE_ME_SUPERSET_SECRET_KEY
SUPERSET_ADMIN_PWD=CHANGE_ME_SUPERSET_ADMIN_PWD
SUPERSET_STARROCKS_URL='mysql+pymysql://root:CHANGE_ME_PWD@starrocks:9030/demo_sr?charset=utf8'
SUPERSET_DORIS_URL='mysql+pymysql://root:CHANGE_ME_PWD@doris-fe:9030/game_db?charset=utf8'

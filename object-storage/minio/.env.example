# MinIO 环境变量案例
# 复制本文件为同目录 .env。
# 替换所有 CHANGE_ME 后再启动服务。
# 真值文件权限设为 600。
MINIO_TAG=CHANGE_ME_MINIO_TAG
MC_TAG=CHANGE_ME_MC_TAG
MINIO_AK=CHANGE_ME_MINIO_AK
MINIO_SK=CHANGE_ME_MINIO_SK
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ROOT_USER_FILE=CHANGE_ME_MINIO_ROOT_USER_FILE
MINIO_ROOT_PASSWORD_FILE=CHANGE_ME_MINIO_ROOT_PASSWORD_FILE
